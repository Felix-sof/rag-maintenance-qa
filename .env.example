GEMINI_API_KEY=your-api-key-here

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash   # answers when the main model is overloaded or out of quota
# EMBED_MODEL=intfloat/multilingual-e5-small

# PostgreSQL + pgvector instead of the local ChromaDB index
# VECTOR_BACKEND=pgvector
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# KEYWORD_BACKEND=bm25          # or pg_fts_stems / pg_fts_turkish (Postgres full-text search)
# With DATABASE_URL set, every question is logged for analytics/; QUERY_LOG=off turns that off
# QUERY_LOG=on
